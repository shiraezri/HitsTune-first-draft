<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HitsTune_first_draft.MainPage"
             Title="דף הבית"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1E1B4B">

    <ScrollView VerticalOptions="Center">
        <VerticalStackLayout Padding="30" Spacing="25" HorizontalOptions="Center" MaximumWidthRequest="400">

            <!-- כותרת ראשית -->
            <Label Text="🎵 HitsTune"
                   FontSize="42"
                   FontAttributes="Bold"
                   TextColor="#818CF8"
                   HorizontalOptions="Center" />

            <!-- ברכת שלום לשחקן -->
            <Label x:Name="WelcomeLabel"
                   Text="שלום, שחקן!"
                   FontSize="22"
                   TextColor="White"
                   HorizontalOptions="Center" />

            <!-- כרטיסיית הדרכה קצרה -->
            <Border Stroke="#4338CA"
                    StrokeThickness="1"
                    BackgroundColor="#312E81"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="מוכנה למבחן המוזיקה?"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#A5B4FC"
                           HorizontalOptions="Center" />
                    <Label Text="זהי את השירים, נחשי את התשובות הנכונות וצברי את הניקוד הגבוה ביותר!"
                           FontSize="14"
                           TextColor="#C7D2FE"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- כפתור כניסה למשחק -->
            <Button Text="🎮 התחל משחק"
                    BackgroundColor="#6366F1"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="55"
                    Clicked="OnStartGameClicked" />

            <!-- כפתור התנתקות -->
            <Button Text="התנתק"
                    BackgroundColor="Transparent"
                    TextColor="#F87171"
                    FontSize="14"
                    Clicked="OnLogoutClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>