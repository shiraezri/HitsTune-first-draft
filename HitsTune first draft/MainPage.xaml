<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HitsTune_first_draft.MainPage"
             Title="לובי המשחק"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0F172A">

    <ScrollView VerticalOptions="FillAndExpand">
        <VerticalStackLayout Padding="25" Spacing="25" HorizontalOptions="Center" MaximumWidthRequest="420">

            <!-- כותרת עליונה: פרופיל שחקן ומד גביעים -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,20,0,10">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="ברוך הבא," FontSize="14" TextColor="#94A3B8" />
                    <Label x:Name="PlayerNameLabel" Text="שחקן" FontSize="26" FontAttributes="Bold" TextColor="White" />
                </VerticalStackLayout>

                <!-- תצוגת גביעים בסגנון Brawl Stars -->
                <Border Grid.Column="1" 
                        BackgroundColor="#1E293B" 
                        Stroke="#F59E0B" 
                        StrokeThickness="2" 
                        Padding="12,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="🏆" FontSize="20" VerticalOptions="Center" />
                        <Label x:Name="TrophiesLabel" Text="0" FontSize="18" FontAttributes="Bold" TextColor="#FBBF24" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- לוגו המשחק -->
            <Label Text="🎵 HitsTune" 
                   FontSize="38" 
                   FontAttributes="Bold" 
                   TextColor="#818CF8" 
                   HorizontalOptions="Center" 
                   Margin="0,10" />

            <!-- כרטיסיית יצירת חדר -->
            <Border BackgroundColor="#1E1B4B" Stroke="#4F46E5" StrokeThickness="1.5" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="👑 צור חדר חדש" FontSize="20" FontAttributes="Bold" TextColor="#A5B4FC" HorizontalOptions="Center" />
                    <Label Text="הזמן חברים למשחק Hitster מותח בזמן אמת!" FontSize="13" TextColor="#C7D2FE" HorizontalTextAlignment="Center" />
                    <Button Text="צור חדר" 
                            BackgroundColor="#6366F1" 
                            TextColor="White" 
                            FontSize="16" 
                            FontAttributes="Bold" 
                            CornerRadius="12" 
                            HeightRequest="50" 
                            Clicked="OnCreateRoomClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- כרטיסיית הצטרפות לחדר -->
            <Border BackgroundColor="#0F2942" Stroke="#0284C7" StrokeThickness="1.5" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="🎮 הצטרף לחדר קיים" FontSize="20" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" />
                    <Entry x:Name="RoomCodeEntry" 
                           Placeholder="הזן קוד חדר (לדוגמה: 4A8B)" 
                           PlaceholderColor="#64748B" 
                           TextColor="White" 
                           MaxLength="6" 
                           HorizontalTextAlignment="Center" 
                           FontSize="16" 
                           BackgroundColor="#1E293B" />
                    <Button Text="הצטרף לחדר" 
                            BackgroundColor="#0EA5E9" 
                            TextColor="White" 
                            FontSize="16" 
                            FontAttributes="Bold" 
                            CornerRadius="12" 
                            HeightRequest="50" 
                            Clicked="OnJoinRoomClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- כפתור התנתקות -->
            <Button Text="התנתק מהחשבון" 
                    BackgroundColor="Transparent" 
                    TextColor="#EF4444" 
                    FontSize="14" 
                    Margin="0,10,0,0" 
                    Clicked="OnLogoutClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>