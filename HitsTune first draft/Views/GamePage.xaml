<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HitsTune_first_draft.ViewModels"
             x:Class="HitsTune_first_draft.Views.GamePage"
             Title="HitsTune Game">

    <ContentPage.BindingContext>
        <vm:GameViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15" HorizontalOptions="Center">

            <!-- כותרת ראשית -->
            <Label Text="HitsTune 🎵" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" />

            <!-- אזור התחברות / יצירת חדר -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="צור חדר חדש" Command="{Binding CreateRoomCommand}" VerticalOptions="Center" />
                <Entry Placeholder="קוד חדר" Text="{Binding InputRoomId}" WidthRequest="100" VerticalOptions="Center" />
                <Button Text="הצטרף" Command="{Binding JoinRoomCommand}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <BoxView HeightRequest="1" Color="Gray" HorizontalOptions="FillAndExpand" Margin="0,10" />

            <!-- פרטי החדר -->
            <Label Text="{Binding CurrentRoom.RoomId, StringFormat='קוד חדר: {0}'}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="{Binding CurrentRoom.Status, StringFormat='סטטוס: {0}'}" FontSize="14" HorizontalOptions="Center" />

            <!-- לוח תוצאות (Scoreboard) -->
            <Frame BorderColor="Purple" CornerRadius="10" Padding="15" Margin="0,10" HorizontalOptions="FillAndExpand">
                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
                    <!-- שחקן 1 -->
                    <Label Text="{Binding CurrentRoom.Player1.Name, TargetNullValue='שחקן 1'}" FontAttributes="Bold" Grid.Column="0" HorizontalOptions="Center" />
                    <Label Text="{Binding CurrentRoom.Player1.Score, TargetNullValue='0', StringFormat='ניקוד: {0}'}" Grid.Row="1" Grid.Column="0" HorizontalOptions="Center" />

                    <!-- שחקן 2 -->
                    <Label Text="{Binding CurrentRoom.Player2.Name, TargetNullValue='ממתין לשחקן 2...'}" FontAttributes="Bold" Grid.Column="1" HorizontalOptions="Center" />
                    <Label Text="{Binding CurrentRoom.Player2.Score, TargetNullValue='-', StringFormat='ניקוד: {0}'}" Grid.Row="1" Grid.Column="1" HorizontalOptions="Center" />
                </Grid>
            </Frame>

            <!-- ציר הזמן של שחקן 1 -->
            <Label Text="ציר הזמן - שחקן 1" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
            <CollectionView ItemsSource="{Binding CurrentRoom.Player1.Timeline}" ItemsLayout="HorizontalList" HeightRequest="90">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="MediumPurple" CornerRadius="8" Padding="10" Margin="5,0" WidthRequest="130" BackgroundColor="#F0F0F8">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="12" LineBreakMode="TailTruncation" HorizontalOptions="Center"/>
                                <Label Text="{Binding Artist}" FontSize="10" LineBreakMode="TailTruncation" HorizontalOptions="Center"/>
                                <Label Text="{Binding ReleaseYear}" FontAttributes="Bold" FontSize="14" TextColor="Purple" HorizontalOptions="Center" Margin="0,2,0,0"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ציר הזמן של שחקן 2 -->
            <Label Text="ציר הזמן - שחקן 2" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" Margin="0,10,0,0" />
            <CollectionView ItemsSource="{Binding CurrentRoom.Player2.Timeline}" ItemsLayout="HorizontalList" HeightRequest="90">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="MediumPurple" CornerRadius="8" Padding="10" Margin="5,0" WidthRequest="130" BackgroundColor="#F0F0F8">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="12" LineBreakMode="TailTruncation" HorizontalOptions="Center"/>
                                <Label Text="{Binding Artist}" FontSize="10" LineBreakMode="TailTruncation" HorizontalOptions="Center"/>
                                <Label Text="{Binding ReleaseYear}" FontAttributes="Bold" FontSize="14" TextColor="Purple" HorizontalOptions="Center" Margin="0,2,0,0"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" Color="Gray" HorizontalOptions="FillAndExpand" Margin="0,10" />

            <!-- הודעת סטטוס תור -->
            <Label Text="{Binding TurnStatusMessage}" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="Purple" 
                   HorizontalOptions="Center" />

            <!-- טיימר ופרטי שיר -->
            <Label Text="{Binding CurrentRoom.TimerSeconds, StringFormat='זמן נותר: {0} שניות'}" FontSize="20" TextColor="Red" HorizontalOptions="Center" />
            <Label Text="{Binding CurrentRoom.CurrentSong.Title, StringFormat='שיר: {0}'}" FontSize="18" HorizontalOptions="Center" />
            <Label Text="{Binding CurrentRoom.CurrentSong.Artist, StringFormat='אמן: {0}'}" FontSize="16" HorizontalOptions="Center" />

            <!-- אזור הניחוש (מנוטרל כשזה לא התור שלך) -->
            <Entry Placeholder="הזן שנת יציאה" 
                   Text="{Binding GuessedYear}" 
                   Keyboard="Numeric" 
                   WidthRequest="150" 
                   IsEnabled="{Binding IsMyTurn}"
                   HorizontalOptions="Center" />

            <Button Text="שלח ניחוש" 
                    Command="{Binding SubmitGuessCommand}" 
                    IsEnabled="{Binding IsMyTurn}"
                    HorizontalOptions="Center" />

            <!-- הודעת משוב -->
            <Label Text="{Binding FeedbackMessage}" FontSize="16" FontAttributes="Italic" HorizontalOptions="Center" Margin="0,10" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>